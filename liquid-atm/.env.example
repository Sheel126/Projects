# --- Alpaca (PAPER keys only during Phases 0-8) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Local LLM (Ollama on the host; no paid APIs) ---
# From inside Docker use http://host.docker.internal:11434, from the host use http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:14b-instruct
LLM_MAX_CONCURRENCY=1

# --- Infra (host ports; containers talk on the internal network) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://liquidatm:change-me@localhost:5433/liquidatm
REDIS_URL=redis://localhost:6380/0

# --- SEC EDGAR requires a descriptive User-Agent with contact email (Phase 1) ---
SEC_USER_AGENT="liquid-atm research your-email@example.com"
