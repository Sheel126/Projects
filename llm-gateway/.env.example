# Copy to .env (never commit .env) and fill in values.

# Provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional provider base URLs (defaults match public APIs)
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Database
POSTGRES_PASSWORD=
DATABASE_URL=jdbc:postgresql://localhost:5432/llmgateway
DATABASE_USER=gateway
DATABASE_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379
SPRING_DATA_REDIS_URL=

# Server
SERVER_PORT=8080

# Spring
SPRING_PROFILES_ACTIVE=

# Observability
GRAFANA_PASSWORD=

# Cache config (Phase 2)
EXACT_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
EXACT_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
EMBEDDING_MODEL=text-embedding-3-small

# Rate limiting defaults (reserved for Phase 3)
DEFAULT_RATE_LIMIT_RPM=60

# Gateway auth + rate limiting (Phase 3)
GATEWAY_AUTH_ENABLED=false
GATEWAY_AUTH_HEADER_NAME=X-API-Key
# HMAC secret used to hash API keys before storing in Postgres (never commit a real value)
GATEWAY_API_KEY_HMAC_SECRET=
# Admin token for creating/revoking API keys via /v1/admin/* endpoints
GATEWAY_ADMIN_TOKEN=
GATEWAY_RATE_LIMIT_ENABLED=false
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
