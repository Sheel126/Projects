# Copy to .env (never commit .env) and fill in values.

# Provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional provider base URLs (defaults match public APIs)
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Database
POSTGRES_PASSWORD=
DATABASE_URL=jdbc:postgresql://localhost:5432/llmgateway
DATABASE_USER=gateway
DATABASE_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379
SPRING_DATA_REDIS_URL=

# Server
SERVER_PORT=8080

# Spring
SPRING_PROFILES_ACTIVE=

# Observability
GRAFANA_PASSWORD=

# Cache config (reserved for Phase 2)
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
EXACT_CACHE_TTL_SECONDS=3600

# Rate limiting defaults (reserved for Phase 3)
DEFAULT_RATE_LIMIT_RPM=60
