# Alpaca Paper Trading (required)
# Sign up: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Ollama on Windows (native — same machine as bot)
# Start: Ollama desktop app (preferred) OR: ollama serve
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SEC=120

# Strategy mode: daily_active (frequent trades) | swing (fewer SETUP_LONG holds)
BOT_TRADING_MODE=daily_active
BOT_REQUIRE_DAILY_ACTIVITY=true

# Diversified volatile watchlist (16 names across sectors)
BOT_WATCHLIST=NVDA,AMD,META,PLTR,SOFI,TSLA,HOOD,COIN,SOXL,XLK,ARKK,BAC,XLE,IWM,MARA,RIOT
BOT_SWING_PROFILE=high_beta
BOT_BENCHMARK=QQQ

# Daily-active tuning
BOT_DIP_BUY_FROM_OPEN_PCT=-0.2
BOT_QUICK_PROFIT_PCT=0.35
BOT_QUICK_STOP_LOSS_PCT=1.0
BOT_ACTIVE_POSITION_PCT=10
BOT_ACTIVE_MAX_BUYS_PER_CYCLE=2
CYCLE_MINUTES=10

# Intraday signals (VWAP, IBS mean-reversion, opening range, EOD flat)
BOT_USE_INTRADAY_SIGNALS=true
BOT_ORB_MINUTES=15
BOT_EOD_FLAT_HOUR=15
BOT_EOD_FLAT_MINUTE=55
BOT_VWAP_BUY_BELOW_PCT=-0.1
BOT_IBS_OVERSOLD=0.25

# Risk (smaller positions, more rotation)
RISK_PER_TRADE_PCT=0.02
MAX_POSITIONS=6
MAX_POSITION_PCT=0.18
DAILY_LOSS_HALT_PCT=0.05
MIN_ORDER_NOTIONAL=50

# Dashboard
BOT_DASHBOARD_HOST=127.0.0.1
BOT_DASHBOARD_PORT=5001

BOT_DRY_RUN=false
