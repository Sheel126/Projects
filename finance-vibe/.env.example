# Alpaca Paper Trading (required)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SEC=120

BOT_TRADING_MODE=daily_active
BOT_REQUIRE_DAILY_ACTIVITY=false
BOT_WATCHLIST=NVDA,AMD,META,TSLA,PLTR,SMCI,COIN,HOOD,SOFI,AAPL,AMZN,NFLX,XOM,GLD
BOT_SWING_PROFILE=high_beta
BOT_BENCHMARK=QQQ

BOT_DASHBOARD_HOST=127.0.0.1
BOT_DASHBOARD_PORT=5001
BOT_DRY_RUN=false

# ---------------------------------------------------------------------------
# THE NINE STRATEGY KNOBS - frozen for the two-week run.
# Anything not listed here was deleted as noise-fitted; see config.py.
# ---------------------------------------------------------------------------
BOT_ATR_EXIT_MULT=0.5
BOT_MIN_BUY_SCORE=38
BOT_ENTRY_MIN_FROM_OPEN_PCT=-2.5
BOT_ENTRY_MAX_FROM_OPEN_PCT=3.5
BOT_VWAP_BUY_MAX_ABOVE_PCT=1.0
BOT_ACTIVE_POSITION_PCT=13
MAX_POSITIONS=5
BOT_DAY_BLOCK_BUYS_PCT=-1.0
BOT_BENCHMARK_BLOCK_PCT=-0.4

# --- structural, not strategy tuning ---
BOT_ACTIVE_MAX_BUYS_PER_CYCLE=2
BOT_WHOLE_SHARES_ONLY=true
CYCLE_MINUTES=20
BOT_LATE_ENTRY_HOUR=15
BOT_LATE_ENTRY_MINUTE=30
BOT_USE_INTRADAY_SIGNALS=true
BOT_EOD_FLAT_HOUR=15
BOT_EOD_FLAT_MINUTE=55
DAILY_LOSS_HALT_PCT=0.05
MIN_ORDER_NOTIONAL=50
BOT_USE_BROKER_STOPS=false
