# OpenAI — scripting agents (Phase 1) + Whisper timestamps (Phase 2)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs — narrator TTS (Phase 2)
# Get key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ElevenLabs voice ID for documentary narrator
# Find in: ElevenLabs → Voices → voice settings → Voice ID
ELEVENLABS_VOICE_ID=

# Image generation provider: comfyui (default, local) or replicate
IMAGE_PROVIDER=comfyui

# ComfyUI — local FLUX / workflow-driven image generation
# Start ComfyUI separately, then point the app at its HTTP API.
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Optional override; default is backend/assets/comfyui/flux_schnell_16x9.json
# COMFYUI_WORKFLOW_PATH=./assets/comfyui/flux_schnell_16x9.json
COMFYUI_TIMEOUT_SECONDS=300
COMFYUI_POLL_INTERVAL_SECONDS=1.5
COMFYUI_DEFAULT_WIDTH=1280
COMFYUI_DEFAULT_HEIGHT=720
# COMFYUI_OUTPUT_SUBDIR=

# Replicate — optional fallback when IMAGE_PROVIDER=replicate
# Get token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# SQLite connection string
DATABASE_URL=sqlite:///./history_app.db

# Optional overrides
PORT=8000
BACKGROUND_MUSIC_PATH=./assets/audio/music/suspense_background.mp3

# Image model when using Replicate (Apache 2.0 — commercial / YouTube OK)
# FLUX_MODEL=black-forest-labs/flux-schnell
